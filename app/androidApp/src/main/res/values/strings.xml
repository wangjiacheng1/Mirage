    <!-- ===================================================================
         结算回执
         「没有变化」和「结算失败」必须用完全不同的措辞，并且只有后者给重算入口：
         合成一句含糊的「没更新」，使用者就无法判断要不要重来 ——
         该重来时不重来会让数值一直少一截，不该重来时重来是白花一次钱。
         =================================================================== -->
    <string name="settlement_status_pending">准备结算…</string>
    <string name="settlement_status_waiting">排队等待结算（前面还有 %1$d 轮）</string>
    <string name="settlement_status_running">正在结算数值…</string>
    <string name="settlement_status_updated">数值已更新（%1$d 项）</string>
    <string name="settlement_status_partial">部分更新：%1$d 项已生效，%2$d 项未采用</string>
    <string name="settlement_status_unchanged">本轮没有数值变化</string>
    <string name="settlement_status_error">本轮结算失败，数值未改动</string>
    <string name="settlement_status_stale">剧情已改动，这次结算结果已作废</string>
    <string name="settlement_status_interrupted">结算被中断，数值未改动</string>
    <string name="settlement_attempt">第 %1$d 次尝试</string>
    <string name="settlement_change_line">%1$s　%2$s → %3$s</string>
    <string name="settlement_change_adjusted">（已按规则修正）</string>
    <string name="settlement_change_reason">原因：%1$s</string>
    <string name="settlement_usage">结算开销：%1$s</string>
    <!-- 三种可重试状态的起因不同，按钮就该说不同的话 -->
